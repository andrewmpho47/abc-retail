<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
    <header class="bg-blue-600 text-white shadow-lg">
        <nav class="container mx-auto px-4 py-4">
            <div class="flex flex-wrap items-center justify-between">
                <a class="text-2xl font-bold hover:text-blue-200 transition-colors" asp-area="" asp-controller="Home" asp-action="Index">
                    ABC Retail
                </a>
                <button id="mobile-menu-button" class="md:hidden p-2 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                <div id="nav-menu" class="hidden w-full md:flex md:w-auto md:items-center mt-4 md:mt-0">
                    <ul class="flex flex-col md:flex-row md:space-x-6 space-y-2 md:space-y-0">
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Customer" asp-action="Index">Customers</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Image" asp-action="Index">Images</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Multimedia" asp-action="Index">Multimedia</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="OrderQueue" asp-action="Index">Orders</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="InventoryQueue" asp-action="Index">Inventory</a>
                        </li>
                        <li>
                            <a class="block px-3 py-2 rounded-lg hover:bg-blue-700 transition-colors" asp-area="" asp-controller="Log" asp-action="Index">Logs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mx-auto px-4 py-8 flex-grow">
        @if (TempData["Success"] != null)
        {
            <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                @TempData["Error"]
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-gray-800 text-white py-4">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; @DateTime.Now.Year ABC Retail</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            var menu = document.getElementById('nav-menu');
            menu.classList.toggle('hidden');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
