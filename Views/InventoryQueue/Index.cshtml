@model IEnumerable<ABCRetail.Models.QueueMessageInfo>

@{
    ViewData["Title"] = "Inventory Management Queue";
    var messageCount = ViewBag.MessageCount as int? ?? 0;
}

<div class="mb-6">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-3xl font-bold text-gray-800">Inventory Management Queue</h1>
        <a asp-action="Send" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
            Send Inventory Message
        </a>
    </div>
    <p class="text-gray-600">Manage inventory update messages in Azure Queue Storage.</p>
</div>

<div class="bg-white shadow-md rounded-lg p-4 mb-6">
    <div class="flex items-center justify-between">
        <div>
            <span class="text-sm text-gray-500">Approximate Messages in Queue</span>
            <p class="text-3xl font-bold text-purple-600">@messageCount</p>
        </div>
        <form asp-action="Process" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors" @(messageCount == 0 ? "disabled" : "")>
                Process Next Message
            </button>
        </form>
    </div>
</div>

<div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b">
        <h2 class="text-lg font-semibold text-gray-800">Queue Messages (Peeked - Not Removed)</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Message ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Inserted</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">No messages in the queue. Click "Send Inventory Message" to add one.</td>
                </tr>
            }
            @foreach (var message in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">@message.MessageId.Substring(0, Math.Min(8, message.MessageId.Length))...</td>
                    <td class="px-6 py-4 text-sm text-gray-900">@message.Content</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(message.InsertedOn?.ToString("MMM dd, HH:mm") ?? "N/A")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(message.ExpiresOn?.ToString("MMM dd, HH:mm") ?? "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-6 bg-purple-50 border border-purple-200 rounded-lg p-4">
    <h3 class="text-sm font-semibold text-purple-800 mb-2">Queue Message Format</h3>
    <p class="text-sm text-purple-700 font-mono">
        [ActionType] inventory for [ProductId]: [Quantity] units - [Reason]
    </p>
</div>
