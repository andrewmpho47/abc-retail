@model ABCRetail.Models.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Create Product</h1>
        <p class="text-gray-600">Add a new product to Azure Table Storage.</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="Category" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Category" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., Electronics" />
                    <span asp-validation-for="Category" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="ProductId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="ProductId" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., PROD001" />
                    <span asp-validation-for="ProductId" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ProductName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ProductName" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="ProductName" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Description" rows="3" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div>
                    <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg p-2 pl-7 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <span asp-validation-for="Price" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="StockQuantity" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="StockQuantity" type="number" min="0" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="StockQuantity" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Create Product
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
