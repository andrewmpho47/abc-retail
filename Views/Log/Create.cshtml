@model ABCRetail.Models.ViewModels.LogFileFormViewModel

@{
    ViewData["Title"] = "Create Log File";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Create Log File</h1>
        <p class="text-gray-600">Create a new log file.</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label asp-for="FileName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FileName" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., application.log" />
                <p class="text-xs text-gray-500 mt-1">Extension .txt will be added if not specified</p>
                <span asp-validation-for="FileName" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Content" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Content" rows="10" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm" placeholder="Enter log content..."></textarea>
                <span asp-validation-for="Content" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Create File
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
