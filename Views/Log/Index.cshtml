@model IEnumerable<ABCRetail.Models.LogFileInfo>

@{
    ViewData["Title"] = "Log Files";
}

<div class="mb-6">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-3xl font-bold text-gray-800">Log Files</h1>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
            Create Log File
        </a>
    </div>
    <p class="text-gray-600">Manage application log files.</p>
</div>

<div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Size</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Modified</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">No log files found. Click "Create Log File" to add one.</td>
                </tr>
            }
            @foreach (var file in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-gray-400 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-sm font-medium text-gray-900">@file.FileName</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@FormatFileSize(file.Size)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(file.LastModified?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                        <a asp-action="View" asp-route-fileName="@file.FileName" class="text-blue-600 hover:text-blue-900">View</a>
                        <a asp-action="Download" asp-route-fileName="@file.FileName" class="text-green-600 hover:text-green-900">Download</a>
                        <a asp-action="Delete" asp-route-fileName="@file.FileName" class="text-red-600 hover:text-red-900">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4 text-sm text-gray-500">
    Total files: @Model.Count()
</div>

@functions {
    string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }
}
