@model ABCRetail.Models.CustomerProfile

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Delete Customer</h1>
        <p class="text-gray-600">Are you sure you want to delete this customer?</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6 border-l-4 border-red-500">
        <div class="flex items-center mb-4">
            <svg class="w-8 h-8 text-red-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="text-lg font-semibold text-gray-800">This action cannot be undone.</span>
        </div>

        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
                <dt class="text-sm font-medium text-gray-500">Partition Key</dt>
                <dd class="mt-1 text-gray-900">@Model.PartitionKey</dd>
            </div>
            <div>
                <dt class="text-sm font-medium text-gray-500">Row Key</dt>
                <dd class="mt-1 text-gray-900">@Model.RowKey</dd>
            </div>
            <div>
                <dt class="text-sm font-medium text-gray-500">Name</dt>
                <dd class="mt-1 text-gray-900">@Model.FirstName @Model.LastName</dd>
            </div>
            <div>
                <dt class="text-sm font-medium text-gray-500">Email</dt>
                <dd class="mt-1 text-gray-900">@Model.Email</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="partitionKey" value="@Model.PartitionKey" />
            <input type="hidden" name="rowKey" value="@Model.RowKey" />

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Delete Customer
                </button>
            </div>
        </form>
    </div>
</div>
