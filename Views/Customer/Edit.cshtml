@model ABCRetail.Models.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Edit Customer</h1>
        <p class="text-gray-600">Update customer profile in Azure Table Storage.</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="etag" value="@ViewBag.ETag" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="PartitionKey" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="PartitionKey" class="w-full border border-gray-300 rounded-lg p-2 bg-gray-100" readonly />
                    <span asp-validation-for="PartitionKey" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="RowKey" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="RowKey" class="w-full border border-gray-300 rounded-lg p-2 bg-gray-100" readonly />
                    <span asp-validation-for="RowKey" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="FirstName" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="LastName" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="LastName" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-4">
                <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PhoneNumber" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="PhoneNumber" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Address" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Address" rows="3" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                <span asp-validation-for="Address" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
