@{
    ViewData["Title"] = "Upload Image";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Upload Image</h1>
        <p class="text-gray-600">Upload a new image to Azure Blob Storage.</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-6">
                <label for="file" class="block text-sm font-medium text-gray-700 mb-2">Select Image File</label>
                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:border-blue-400 transition-colors">
                    <div class="space-y-1 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <div class="flex text-sm text-gray-600">
                            <label for="file" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                                <span>Upload a file</span>
                                <input id="file" name="file" type="file" class="sr-only" accept=".jpg,.jpeg,.png,.gif,.webp" onchange="updateFileName(this)" />
                            </label>
                            <p class="pl-1">or drag and drop</p>
                        </div>
                        <p class="text-xs text-gray-500">JPEG, PNG, GIF, WebP up to 10MB</p>
                        <p id="selectedFile" class="text-sm text-blue-600 font-medium mt-2"></p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Accepted File Types</h3>
                <ul class="text-sm text-gray-600 space-y-1">
                    <li>• JPEG/JPG images</li>
                    <li>• PNG images</li>
                    <li>• GIF images</li>
                    <li>• WebP images</li>
                </ul>
                <p class="text-xs text-gray-500 mt-2">Maximum file size: 10 MB</p>
            </div>

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Upload Image
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function updateFileName(input) {
        var fileName = input.files[0] ? input.files[0].name : '';
        document.getElementById('selectedFile').textContent = fileName ? 'Selected: ' + fileName : '';
    }
</script>
