@model IEnumerable<ABCRetail.Models.BlobItemInfo>

@{
    ViewData["Title"] = "Image Gallery";
    var notifications = ViewBag.Notifications as IEnumerable<ABCRetail.Models.QueueMessageInfo> ?? Enumerable.Empty<ABCRetail.Models.QueueMessageInfo>();
}

<div class="mb-6">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-3xl font-bold text-gray-800">Image Gallery</h1>
        <a asp-action="Upload" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
            Upload Image
        </a>
    </div>
    <p class="text-gray-600">Manage product images.</p>
</div>

@if (notifications.Any())
{
    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="text-sm font-semibold text-blue-800 mb-2">Recent Upload Notifications</h3>
        <ul class="text-sm text-blue-700 space-y-1">
            @foreach (var notification in notifications.Take(5))
            {
                <li class="flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    @notification.Content
                </li>
            }
        </ul>
    </div>
}

@if (!Model.Any())
{
    <div class="bg-white shadow-md rounded-lg p-8 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <p class="text-gray-500">No images found. Click "Upload Image" to add your first image.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @foreach (var image in Model)
        {
            <div class="bg-white shadow-md rounded-lg overflow-hidden">
                <div class="aspect-w-16 aspect-h-12 bg-gray-100">
                    <img src="@Url.Action("Download", new { blobName = image.BlobName })" alt="@image.OriginalFileName" class="w-full h-48 object-cover" />
                </div>
                <div class="p-4">
                    <h3 class="text-sm font-medium text-gray-900 truncate" title="@image.OriginalFileName">
                        @(string.IsNullOrEmpty(image.OriginalFileName) ? image.BlobName : image.OriginalFileName)
                    </h3>
                    <p class="text-xs text-gray-500 mt-1">
                        @FormatFileSize(image.Size) • @(image.UploadTimestamp?.ToString("MMM dd, yyyy") ?? "N/A")
                    </p>
                    <div class="mt-3 flex space-x-2">
                        <a asp-action="Download" asp-route-blobName="@image.BlobName" target="_blank" class="text-blue-600 hover:text-blue-800 text-sm">View</a>
                        <a asp-action="Download" asp-route-blobName="@image.BlobName" class="text-green-600 hover:text-green-800 text-sm">Download</a>
                        <a asp-action="Delete" asp-route-blobName="@image.BlobName" class="text-red-600 hover:text-red-800 text-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4 text-sm text-gray-500">
    Total images: @Model.Count()
</div>

@functions {
    string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }
}
