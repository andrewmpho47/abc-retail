@model IEnumerable<ABCRetail.Models.BlobItemInfo>

@{
    ViewData["Title"] = "Multimedia Files";
}

<div class="mb-6">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-3xl font-bold text-gray-800">Multimedia Files</h1>
        <a asp-action="Upload" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
            Upload File
        </a>
    </div>
    <p class="text-gray-600">Manage multimedia files (PDF, MP4, DOCX, XLSX) stored in Azure Blob Storage.</p>
</div>

<div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Size</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">No multimedia files found. Click "Upload File" to add your first file.</td>
                </tr>
            }
            @foreach (var file in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            @{
                                var iconClass = GetFileIcon(file.ContentType);
                            }
                            <svg class="w-8 h-8 @iconClass mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <div class="text-sm font-medium text-gray-900">
                                    @(string.IsNullOrEmpty(file.OriginalFileName) ? file.BlobName : file.OriginalFileName)
                                </div>
                                <div class="text-xs text-gray-500 truncate max-w-xs">@file.BlobName</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @GetTypeBadgeClass(file.ContentType)">
                            @GetFileTypeLabel(file.ContentType)
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@FormatFileSize(file.Size)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(file.UploadTimestamp?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                        <a asp-action="Download" asp-route-blobName="@file.BlobName" class="text-green-600 hover:text-green-900">Download</a>
                        <a asp-action="Delete" asp-route-blobName="@file.BlobName" class="text-red-600 hover:text-red-900">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4 text-sm text-gray-500">
    Total files: @Model.Count()
</div>

@functions {
    string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    string GetFileIcon(string contentType)
    {
        return contentType switch
        {
            "application/pdf" => "text-red-500",
            "video/mp4" => "text-purple-500",
            var t when t.Contains("word") => "text-blue-500",
            var t when t.Contains("spreadsheet") || t.Contains("excel") => "text-green-500",
            _ => "text-gray-500"
        };
    }

    string GetTypeBadgeClass(string contentType)
    {
        return contentType switch
        {
            "application/pdf" => "bg-red-100 text-red-800",
            "video/mp4" => "bg-purple-100 text-purple-800",
            var t when t.Contains("word") => "bg-blue-100 text-blue-800",
            var t when t.Contains("spreadsheet") || t.Contains("excel") => "bg-green-100 text-green-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    string GetFileTypeLabel(string contentType)
    {
        return contentType switch
        {
            "application/pdf" => "PDF",
            "video/mp4" => "MP4",
            var t when t.Contains("word") => "DOCX",
            var t when t.Contains("spreadsheet") || t.Contains("excel") => "XLSX",
            _ => "FILE"
        };
    }
}
