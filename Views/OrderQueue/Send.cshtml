@model ABCRetail.Models.ViewModels.OrderFormViewModel

@{
    ViewData["Title"] = "Send Order Message";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Send Order Message</h1>
        <p class="text-gray-600">Add a new order processing message to Azure Queue Storage.</p>
    </div>

    <div class="bg-white shadow-md rounded-lg p-6">
        <form asp-action="Send" method="post">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="OrderId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="OrderId" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., ORD001" />
                    <span asp-validation-for="OrderId" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="CustomerId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="CustomerId" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., CUST001" />
                    <span asp-validation-for="CustomerId" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="ProductId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="ProductId" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., PROD001" />
                    <span asp-validation-for="ProductId" class="text-red-600 text-sm"></span>
                </div>
                <div>
                    <label asp-for="Quantity" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Quantity" type="number" min="1" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <span asp-validation-for="Quantity" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="mb-6">
                <label asp-for="OrderStatus" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <select asp-for="OrderStatus" class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="">Select Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Processing">Processing</option>
                    <option value="Shipped">Shipped</option>
                    <option value="Completed">Completed</option>
                </select>
                <span asp-validation-for="OrderStatus" class="text-red-600 text-sm"></span>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Message Preview</h3>
                <p class="text-sm text-gray-600 font-mono" id="messagePreview">
                    Processing order [OrderId] for customer [CustomerId]: [Quantity] x [ProductId]
                </p>
            </div>

            <div class="flex justify-between">
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors">
                    Send Message
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updatePreview() {
            var orderId = document.getElementById('OrderId').value || '[OrderId]';
            var customerId = document.getElementById('CustomerId').value || '[CustomerId]';
            var productId = document.getElementById('ProductId').value || '[ProductId]';
            var quantity = document.getElementById('Quantity').value || '[Quantity]';
            document.getElementById('messagePreview').textContent = 
                'Processing order ' + orderId + ' for customer ' + customerId + ': ' + quantity + ' x ' + productId;
        }
        document.querySelectorAll('input, select').forEach(el => el.addEventListener('input', updatePreview));
    </script>
}
